# Copy to .env. Everything here is optional for local use:
# with no .env the app runs on a local SQLite database.

DEBUG=True
# SECRET_KEY=change-me

# For a deployment: the backend's own hostname(s) and the frontend origin(s), comma-separated
# ALLOWED_HOSTS=api.example.com
# CORS_ALLOWED_ORIGINS=https://adaptify-frontend.vercel.app

# Supabase (optional) - store emotions in a Supabase "Emotions" table instead of SQLite
# SUPABASE_URL=https://<project>.supabase.co
# SUPABASE_KEY=
# DEMO_USER_ID=

# Any Postgres (optional) - use it as the database instead of SQLite
# DATABASE_URL=postgres://user:password@host:5432/dbname?sslmode=require

# Supabase Postgres (optional) - use it as the Django database
# SUPABASE_DB_NAME=postgres
# SUPABASE_DB_USER=
# SUPABASE_DB_PASSWORD=
# SUPABASE_DB_HOST=
# SUPABASE_DB_PORT=5432
